@ChommieHub.Api_HostAddress = http://localhost:5154

###########################################################
### HEALTH
###########################################################

### API health
GET {{ChommieHub.Api_HostAddress}}/api/health
Accept: application/json


###########################################################
### ACCOMMODATION
###########################################################

### Create accommodation
POST {{ChommieHub.Api_HostAddress}}/api/accommodations
Content-Type: application/json

{
  "name": "ChommieHub Student Residence",
  "address": "1 Example Street, Johannesburg",
  "latitude": -26.2041,
  "longitude": 28.0473,
  "description": "Student accommodation used for ChommieHub prototype testing.",
  "phoneNumber": "0115550100",
  "amenities": [
    "Wi-Fi",
    "Laundry",
    "Study Area"
  ],
  "institutionArea": "Johannesburg"
}


### Get all accommodation
GET {{ChommieHub.Api_HostAddress}}/api/accommodations
Accept: application/json


### Replace with an accommodation document ID returned by Firestore/API
@accommodationId = TIliENohJOvVmK9dI8LN


### Get accommodation by ID
GET {{ChommieHub.Api_HostAddress}}/api/accommodations/{{accommodationId}}
Accept: application/json


###########################################################
### ROOMS
###########################################################

### Create room
POST {{ChommieHub.Api_HostAddress}}/api/accommodations/{{accommodationId}}/rooms
Content-Type: application/json

{
  "roomType": "Single Room",
  "price": 5500,
  "capacity": 1,
  "availability": true
}


### Get rooms for accommodation
GET {{ChommieHub.Api_HostAddress}}/api/accommodations/{{accommodationId}}/rooms
Accept: application/json


### Replace with a real room document ID
@roomId = REPLACE_WITH_ROOM_ID


### Get room by ID
GET {{ChommieHub.Api_HostAddress}}/api/rooms/{{roomId}}
Accept: application/json


### Update room
PUT {{ChommieHub.Api_HostAddress}}/api/rooms/{{roomId}}
Content-Type: application/json

{
  "roomType": "Single Room",
  "price": 5500,
  "capacity": 1,
  "availability": true
}


###########################################################
### RESIDENCE MANAGER
###########################################################

### Manager dashboard
GET {{ChommieHub.Api_HostAddress}}/api/manager/accommodations/{{accommodationId}}/dashboard
Accept: application/json


### Applications for accommodation
GET {{ChommieHub.Api_HostAddress}}/api/manager/accommodations/{{accommodationId}}/applications
Accept: application/json


### Replace with a real application document ID
@applicationId = REPLACE_WITH_APPLICATION_ID


### View application details
GET {{ChommieHub.Api_HostAddress}}/api/manager/applications/{{applicationId}}
Accept: application/json


### Approve application
PATCH {{ChommieHub.Api_HostAddress}}/api/manager/applications/{{applicationId}}/review
Content-Type: application/json

{
  "decision": "Approved",
  "reviewNotes": "Application information verified and approved."
}


### Decline application
PATCH {{ChommieHub.Api_HostAddress}}/api/manager/applications/{{applicationId}}/review
Content-Type: application/json

{
  "decision": "Declined",
  "reviewNotes": "Application does not currently meet the residence requirements."
}


### Assign room to approved application
POST {{ChommieHub.Api_HostAddress}}/api/manager/applications/{{applicationId}}/assign-room
Content-Type: application/json

{
  "roomId": "{{roomId}}"
}


### View residents
GET {{ChommieHub.Api_HostAddress}}/api/manager/accommodations/{{accommodationId}}/residents
Accept: application/json