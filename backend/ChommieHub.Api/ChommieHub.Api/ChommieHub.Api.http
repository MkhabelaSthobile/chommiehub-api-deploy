@ChommieHub.Api_HostAddress = http://localhost:5154

GET {{ChommieHub.Api_HostAddress}}/api/health
Accept: application/json

### API health
GET {{ChommieHub.Api_HostAddress}}/api/health
Accept: application/json


### Create accommodation
POST {{ChommieHub.Api_HostAddress}}/api/accommodations
Content-Type: application/json

{
  "name": "ChommieHub Student Residence",
  "address": "1 Example Street, Johannesburg",
  "latitude": -26.2041,
  "longitude": 28.0473,
  "description": "Student accommodation used for ChommieHub prototype testing.",
  "phoneNumber": "0115550100",
  "amenities": [
    "Wi-Fi",
    "Laundry",
    "Study Area"
  ],
  "institutionArea": "Johannesburg"
}

### Get all accommodation
GET {{ChommieHub.Api_HostAddress}}/api/accommodations
Accept: application/json


### Replace this value after creating an accommodation
@accommodationId = LDQ1pVJtCJKfTPDpiYDm


### Get accommodation
GET {{ChommieHub.Api_HostAddress}}/api/accommodations/{{accommodationId}}
Accept: application/json


### Create room
POST {{ChommieHub.Api_HostAddress}}/api/accommodations/{{accommodationId}}/rooms
Content-Type: application/json

{
  "roomType": "Single Room",
  "price": 5500,
  "capacity": 1,
  "availability": true
}


### Get rooms for accommodation
GET {{ChommieHub.Api_HostAddress}}/api/accommodations/{{accommodationId}}/rooms
Accept: application/json


### RESIDENCE MANAGER TESTS

### Use an existing accommodation ID
@managerAccommodationId = LDQ1pVJtCJKfTPDpiYDm

### Manager dashboard
GET {{ChommieHub.Api_HostAddress}}/api/manager/accommodations/{{managerAccommodationId}}/dashboard
Accept: application/json


### Applications for accommodation
GET {{ChommieHub.Api_HostAddress}}/api/manager/accommodations/{{managerAccommodationId}}/applications
Accept: application/json


### Replace after an application exists
@applicationId = FoNMutDocJdWoPaWqHxh


### View application details
GET {{ChommieHub.Api_HostAddress}}/api/manager/applications/{{applicationId}}
Accept: application/json


### Approve application
PATCH {{ChommieHub.Api_HostAddress}}/api/manager/applications/{{applicationId}}/review
Content-Type: application/json

{
  "decision": "Approved",
  "reviewNotes": "Application information verified and approved."
}


### Existing available room ID
@managerRoomId = IW6RHQsabu4m01C4lSYN


### Assign room
POST {{ChommieHub.Api_HostAddress}}/api/manager/applications/{{applicationId}}/assign-room
Content-Type: application/json

{
  "roomId": "{{managerRoomId}}"
}


### View residents
GET {{ChommieHub.Api_HostAddress}}/api/manager/accommodations/{{managerAccommodationId}}/residents
Accept: application/json

###
