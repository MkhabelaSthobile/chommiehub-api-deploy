<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for Firebase and the ChommieHub REST API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/chommiehub_app_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/chommiehub_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChommieHub">

        <!-- ================================================= -->
        <!-- Authentication -->
        <!-- ================================================= -->

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.BiometricActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- ================================================= -->
        <!-- Student -->
        <!-- ================================================= -->

        <activity
            android:name=".ui.student.StudentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ================================================= -->
        <!-- Manager -->
        <!-- ================================================= -->

        <activity
            android:name=".ui.manager.ManagerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ================================================= -->
        <!-- Main / Development -->
        <!-- ================================================= -->

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>