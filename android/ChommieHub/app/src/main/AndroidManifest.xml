<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet access for Firebase and ChommieHub API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app check whether the phone is online -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required to display notifications on Android 13 and above -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ChommieHubApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/chommiehub_app_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/chommiehub_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChommieHub">

        <!-- Default channel for Firebase background notifications -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="chommiehub_updates" />

        <!-- Login / Launcher -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
        </activity>

        <!-- Registration -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Biometric authentication -->
        <activity
            android:name=".ui.auth.BiometricActivity"
            android:exported="false" />

        <!-- Admin is never exported, and validates its Firebase claim and backend token. -->
        <activity android:name=".ui.admin.AdminActivity" android:exported="false" />

        <!-- Welcome is the public launcher for signed-out users. -->
        <activity android:name=".ui.auth.WelcomeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Student application -->
        <activity
            android:name=".ui.student.StudentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Manager application -->
        <activity
            android:name=".ui.manager.ManagerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Community screens validate Firebase identity and backend role authorization. -->
        <activity android:name=".ui.community.CommunityActivity" android:exported="false" />

        <!-- Main development activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".firebase.ChommieHubMessagingService"
            android:exported="false">

            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>

        </service>

    </application>

</manifest>
