<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        ChommieHub Material 3 theme.
        Navy provides the primary visual identity while gold is used
        for brand emphasis and secondary actions.
    -->
    <style
        name="Base.Theme.ChommieHub"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/chommie_navy</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/chommie_gold</item>
        <item name="colorOnSecondary">@color/chommie_navy</item>

        <item name="colorSurface">@color/chommie_surface</item>
        <item name="colorOnSurface">@color/chommie_text_primary</item>

        <item name="android:windowBackground">@color/chommie_background</item>

        <item name="android:statusBarColor">@color/chommie_navy</item>
        <item name="android:navigationBarColor">@color/chommie_navy</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

    </style>

    <style
        name="Theme.ChommieHub"
        parent="Base.Theme.ChommieHub" />

</resources>