<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main ChommieHub call-to-action button. -->
    <style
        name="Widget.ChommieHub.Button.Primary"
        parent="Widget.Material3.Button">

        <item name="backgroundTint">@color/chommie_navy</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>

    </style>


    <!-- Secondary action used when the primary action should dominate. -->
    <style
        name="Widget.ChommieHub.Button.Secondary"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="android:textColor">@color/chommie_navy</item>
        <item name="strokeColor">@color/chommie_navy</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>

    </style>


    <!-- Large number displayed inside dashboard statistic cards. -->
    <style
        name="TextAppearance.ChommieHub.StatNumber"
        parent="TextAppearance.Material3.HeadlineMedium">

        <item name="android:textColor">@color/chommie_navy</item>
        <item name="android:textStyle">bold</item>

    </style>


    <!-- Small supporting label underneath dashboard statistics. -->
    <style
        name="TextAppearance.ChommieHub.StatLabel"
        parent="TextAppearance.Material3.BodyMedium">

        <item name="android:textColor">@color/chommie_text_secondary</item>

    </style>

</resources>