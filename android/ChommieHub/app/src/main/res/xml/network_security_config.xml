<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Local prototype development only.
        Android emulator address 10.0.2.2 maps to the host machine.
        The production/cloud API will use HTTPS instead.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

</network-security-config>