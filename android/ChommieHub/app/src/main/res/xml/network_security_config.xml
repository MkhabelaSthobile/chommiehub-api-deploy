<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Local prototype development only.
        Android emulator address 10.0.2.2 maps to the host machine.
        The production/cloud API will use HTTPS instead.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- PC's LAN IP, for testing on a physical phone on the same Wi-Fi.
             This will need updating again if the PC's IP address changes
             (e.g. reconnecting to Wi-Fi, or testing on a different network). -->
        <domain includeSubdomains="false">192.168.101.156</domain>
    </domain-config>

</network-security-config>
