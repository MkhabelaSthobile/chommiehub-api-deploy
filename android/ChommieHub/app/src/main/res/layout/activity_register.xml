<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chommie_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="135dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/logo_description"
            android:scaleType="centerInside"
            android:src="@drawable/chommiehub_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/register_title"
            android:textColor="@color/chommie_navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/register_subtitle"
            android:textColor="@color/chommie_text_secondary" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:autofillHints="givenName"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_first_name"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <EditText
            android:id="@+id/etSurname"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:autofillHints="familyName"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_surname"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_email"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:autofillHints="phone"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_phone"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:autofillHints="newPassword"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_create_password"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:text="@string/password_helper"
            android:textColor="@color/chommie_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:autofillHints="newPassword"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_confirm_password"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/chommie_gold"
            android:text="@string/register_button"
            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/have_account"
            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>