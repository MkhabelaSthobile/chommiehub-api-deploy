<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/chommie_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/visitor_title"            android:textColor="@color/chommie_navy"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/visitor_subtitle"            android:textColor="@color/chommie_text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etVisitorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/visitor_name_hint"            android:inputType="textPersonName"
            android:minHeight="52dp"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etVisitorIdentification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/visitor_id_hint"            android:inputType="text"
            android:minHeight="52dp"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etArrivalDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/visitor_arrival_hint"            android:inputType="text"
            android:minHeight="52dp"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etDepartureDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/visitor_departure_hint"            android:inputType="text"
            android:minHeight="52dp"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkSleepover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/visitor_sleepover"            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvVisitorError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B00020"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <ProgressBar
            android:id="@+id/progressVisitor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitVisitor"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/maintenance_submit"            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/chommie_navy"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/visitor_my_requests"            android:textColor="@color/chommie_navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVisitorEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/visitor_empty"            android:textColor="@color/chommie_text_secondary" />

        <LinearLayout
            android:id="@+id/visitorRequestsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>