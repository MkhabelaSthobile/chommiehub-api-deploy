<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chommie_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResidenceBack"
            style="@style/Widget.ChommieHub.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Manage Residence"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="@color/chommie_text_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Update accommodation information and room inventory"
            android:textColor="@color/chommie_text_secondary" />

        <ProgressBar
            android:id="@+id/progressResidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvResidenceError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/chommie_danger"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etResidenceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Residence name"
            android:inputType="textCapWords"
            android:textColor="@color/chommie_text_primary" />

        <EditText
            android:id="@+id/etResidenceAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Address"
            android:inputType="textPostalAddress"
            android:textColor="@color/chommie_text_primary" />

        <EditText
            android:id="@+id/etResidenceDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textColor="@color/chommie_text_primary" />

        <EditText
            android:id="@+id/etResidencePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Phone number"
            android:inputType="phone"
            android:textColor="@color/chommie_text_primary" />

        <EditText
            android:id="@+id/etResidenceInstitutionArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Institution area"
            android:inputType="textCapWords"
            android:textColor="@color/chommie_text_primary" />

        <EditText
            android:id="@+id/etResidenceAmenities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Amenities separated by commas"
            android:inputType="text"
            android:textColor="@color/chommie_text_primary" />

        <EditText
            android:id="@+id/etResidenceLatitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Latitude"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/chommie_text_primary" />

        <EditText
            android:id="@+id/etResidenceLongitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Longitude"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/chommie_text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveResidence"
            style="@style/Widget.ChommieHub.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Save Changes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageRooms"
            style="@style/Widget.ChommieHub.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Manage Rooms" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>