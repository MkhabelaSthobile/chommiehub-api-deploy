<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chommie_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/application_review_button"            android:textColor="@color/chommie_navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/application_review_subtitle"            android:textColor="@color/chommie_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/application_residence"            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReviewResidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="@color/chommie_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/application_room"            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReviewRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="@color/chommie_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/application_rental_period"            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReviewRentalPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="@color/chommie_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/application_supporting_info"            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReviewSupportingInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="@color/chommie_text_secondary" />

        <ProgressBar
            android:id="@+id/progressApplicationReview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnConfirmSubmitApplication"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/chommie_gold"
            android:text="@string/application_submit_button"            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>