<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_title"            android:textColor="#0B1F3A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_subtitle"            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <ProgressBar
            android:id="@+id/progressProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvProfileError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B00020"
            android:textSize="14sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_retry"            android:visibility="gone"
            android:layout_marginBottom="16dp"
            app:backgroundTint="#D9A441" />

        <LinearLayout
            android:id="@+id/profileFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_first_name"                android:textColor="#0B1F3A"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profile_first_name_hint"                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:padding="12dp"
                android:backgroundTint="#D9A441"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_surname"                android:textColor="#0B1F3A"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etProfileSurname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profile_surname_hint"                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:padding="12dp"
                android:backgroundTint="#D9A441"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_email"                android:textColor="#0B1F3A"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profile_email_hint"                android:inputType="textEmailAddress"
                android:minHeight="48dp"
                android:padding="12dp"
                android:backgroundTint="#D9A441"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_phone"                android:textColor="#0B1F3A"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profile_phone_hint"                android:inputType="phone"
                android:minHeight="48dp"
                android:padding="12dp"
                android:backgroundTint="#D9A441"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_language"                android:textColor="#0B1F3A"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etProfileLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profile_language_hint"                android:inputType="textCapWords"
                android:minHeight="48dp"
                android:padding="12dp"
                android:backgroundTint="#D9A441"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProfileFormError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B00020"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/profile_save"                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#0B1F3A"
                app:cornerRadius="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="6dp"
                android:text="@string/profile_resident_services"                android:textColor="#0B1F3A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/profile_services_subtitle"                android:textColor="#666666"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMaintenance"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/profile_maintenance_requests"                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#0B1F3A"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisitorRequests"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/profile_visitor_requests"                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#0B1F3A"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStudentSignOut"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="@string/profile_sign_out"                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="@color/chommie_danger"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>