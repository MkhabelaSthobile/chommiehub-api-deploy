<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chommie_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_title"
            android:textColor="@color/chommie_navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:autofillHints="givenName"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_profile_name"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <EditText
            android:id="@+id/etProfileSurname"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:autofillHints="familyName"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_profile_surname"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <EditText
            android:id="@+id/etProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_input"
            android:enabled="false"
            android:hint="@string/hint_profile_email"
            android:inputType="textEmailAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/chommie_text_secondary"
            android:textColorHint="@color/chommie_text_secondary" />

        <EditText
            android:id="@+id/etProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:autofillHints="phone"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_profile_phone"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <EditText
            android:id="@+id/etProfileLanguage"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_profile_language"
            android:imeOptions="actionDone"
            android:inputType="text|textCapWords"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/chommie_gold"
            android:text="@string/save_profile"
            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/chommie_surface"
            android:text="@string/settings"
            android:textColor="@color/chommie_navy" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/chommie_danger_soft"
            android:text="@string/log_out"
            android:textColor="@color/chommie_danger" />
    </LinearLayout>
</ScrollView>