<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chommie_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="64dp"
            android:contentDescription="@string/logo_description"
            android:scaleType="centerInside"
            android:src="@drawable/chommiehub_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Accommodation Application"
            android:textColor="@color/chommie_navy"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Select the residence and room you want to apply for."
            android:textColor="@color/chommie_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Residence"
            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spAccommodation"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Available Room"
            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spRoom"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Rental Period"
            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRentalPeriod"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. January 2027 - November 2027"
            android:paddingHorizontal="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Supporting Information"
            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etSupportingInfo"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="Add any information that may support your application"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="18dp"
            android:textColor="@color/chommie_text_primary"
            android:textColorHint="@color/chommie_text_secondary" />

        <Button
            android:id="@+id/btnReviewApplication"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/chommie_gold"
            android:text="Review Application"
            android:textColor="@color/chommie_navy"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>