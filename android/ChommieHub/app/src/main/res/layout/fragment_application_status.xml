<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chommie_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:layout_width="105dp"
            android:layout_height="60dp"
            android:contentDescription="@string/logo_description"
            android:scaleType="centerInside"
            android:src="@drawable/chommiehub_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_title"
            android:textColor="@color/chommie_navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusResidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp"
            android:textColor="@color/chommie_text_secondary" />

        <LinearLayout
            android:id="@+id/stageSubmitted"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="@drawable/bg_status_done"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSubmittedIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/icon_done"
                android:textColor="@color/chommie_success"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvSubmitted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stage_submitted"
                android:textColor="@color/chommie_navy"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:layout_marginStart="36dp"
            android:background="@color/chommie_gold"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/stageReview"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="@drawable/bg_status_waiting"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvReviewIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/icon_waiting"
                android:textColor="@color/chommie_text_secondary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvReview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stage_review"
                android:textColor="@color/chommie_navy"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:layout_marginStart="36dp"
            android:background="@color/chommie_gold"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/stageDecision"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="@drawable/bg_status_waiting"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDecisionIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/icon_waiting"
                android:textColor="@color/chommie_text_secondary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvDecision"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stage_decision"
                android:textColor="@color/chommie_navy"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:layout_marginStart="36dp"
            android:background="@color/chommie_gold"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/stageRoom"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="@drawable/bg_status_waiting"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvRoomIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/icon_waiting"
                android:textColor="@color/chommie_text_secondary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvRoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stage_room"
                android:textColor="@color/chommie_navy"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/manager_update"
            android:textColor="@color/chommie_navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="@color/chommie_text_secondary" />
    </LinearLayout>
</ScrollView>